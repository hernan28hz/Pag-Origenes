# ─── Formulario comercial ───────────────────────────────────────────
# El formulario envía las solicitudes por correo usando Resend (https://resend.com).
# Mientras estas variables no existan, la API responde 503 y el formulario
# lo informa al usuario (no se simula ningún envío).
RESEND_API_KEY=
# Correo(s) del equipo comercial que recibe las solicitudes (separados por coma)
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "Orígenes Coffee <web@dominio.com>"
CONTACT_FROM_EMAIL=

# ─── WhatsApp corporativo ───────────────────────────────────────────
# Número internacional sin "+" ni espacios, p. ej. 573001234567.
# Si se deja vacío, el botón flotante ofrece los contactos comerciales.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── SEO ────────────────────────────────────────────────────────────
# Dominio definitivo, p. ej. https://origenescoffee.com
NEXT_PUBLIC_SITE_URL=
